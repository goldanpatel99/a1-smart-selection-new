{
  "entities": {
    "User": {
      "title": "User",
      "description": "Photographer or Administrator user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["photographer", "admin"] },
        "studioName": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "points": { "type": "number" },
        "watermarkText": { "type": "string" },
        "watermarkPosition": { "type": "string" },
        "watermarkOpacity": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "role", "studioName", "points"]
    },
    "WeddingEvent": {
      "title": "WeddingEvent",
      "description": "Wedding event photography gallery and client selections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "photographerId": { "type": "string" },
        "title": { "type": "string" },
        "coupleName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "eventDate": { "type": "string" },
        "deadlineDate": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "expired"] },
        "slug": { "type": "string" },
        "studioName": { "type": "string" },
        "photosCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "photographerId", "title", "coupleName", "clientPhone", "deadlineDate", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Point recharge or payment log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "pointsAdded": { "type": "number" },
        "amountRupees": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "utrNumber": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "pointsAdded", "status", "createdAt"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Global application configuration and pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "upiId": { "type": "string" },
        "payeeName": { "type": "string" },
        "adminWhatsApp": { "type": "string" },
        "pointsPerEvent": { "type": "number" },
        "pointsPerExtension": { "type": "number" }
      },
      "required": ["id", "upiId", "payeeName", "adminWhatsApp"]
    },
    "Photo": {
      "title": "Photo",
      "description": "Compressed watermarked photo within a wedding event gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "filename": { "type": "string" },
        "originalName": { "type": "string" },
        "folderId": { "type": "string" },
        "folderName": { "type": "string" },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "isSelected": { "type": "boolean" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "filename", "folderName", "url", "isSelected", "uploadedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered photographer and admin profiles"
    },
    "/events/{eventId}": {
      "schema": "WeddingEvent",
      "description": "Wedding events and client photo galleries"
    },
    "/events/{eventId}/photos/{photoId}": {
      "schema": "Photo",
      "description": "Individual compressed photo previews stored in event subcollection"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Points recharges and UPI payment audit entries"
    },
    "/settings/{settingsId}": {
      "schema": "AdminSettings",
      "description": "Global system pricing and UPI settings"
    }
  }
}
