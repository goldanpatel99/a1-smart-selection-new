# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway Credentials (Live / Test)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Firebase Client Configuration (Optional: overrides firebase-applet-config.json)
# If VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID are both set, these are used exclusively.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIRESTORE_DATABASE_ID="(default)"

# Firebase Admin / Server Configuration (Optional)
FIREBASE_PROJECT_ID="your-project-id"
FIRESTORE_DATABASE_ID="(default)"
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id"}'

